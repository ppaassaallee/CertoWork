rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    match /project-docs/{workspaceId}/{projectId}/{fileName} {
      allow read: if request.auth != null;
      allow write: if request.auth != null
        && request.resource.size > 0
        && request.resource.size <= 50 * 1024 * 1024;
    }
    match /workspaces/{workspaceId}/collab/{conversationId}/{messageId}/{fileName} {
      // No current UI calls the legacy Collab upload helper. Never expose
      // workspace attachments to every signed-in user while it is dormant.
      allow read, write: if false;
    }
  }
}
