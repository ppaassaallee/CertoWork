rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if false;
    }

    function isSignedIn() { return request.auth != null; }
    function isOwner(userId) { return request.auth.uid == userId; }
    
    function isValidId(id) { 
      return id is string && id.size() <= 128; 
    }
    
    function incoming() { return request.resource.data; }
    function existing() { return resource.data; }

    // Workspaces
    match /workspaces/{id} {
      allow read: if isSignedIn();
      allow create: if isSignedIn() && incoming().keys().hasAll(['ownerId', 'name', 'createdAt']) && incoming().ownerId == request.auth.uid;
      allow update: if isSignedIn() && (resource.data.ownerId == request.auth.uid || (resource.data.members is list && request.auth.token.email != null && request.auth.token.email in resource.data.members)) && incoming().keys().hasAll(['ownerId', 'name', 'createdAt']) && incoming().ownerId == resource.data.ownerId && incoming().createdAt == resource.data.createdAt;
      allow delete: if isSignedIn() && resource.data.ownerId == request.auth.uid;
    }

    function memberDoc(workspaceId) {
      return /databases/$(database)/documents/workspace_members/$(workspaceId + "_" + request.auth.uid);
    }

    // Helper to check if user belongs to workspace
    function isWorkspaceMember(workspaceId) {
      return isSignedIn() && workspaceId != null
        && exists(memberDoc(workspaceId))
        && get(memberDoc(workspaceId)).data.status == "active";
    }

    function activeWorkspaceMemberId(workspaceId) {
      return workspaceId + "_" + request.auth.uid;
    }

    function isPortfolioViewer(workspaceId) {
      return isSignedIn()
        && workspaceId != null
        && exists(memberDoc(workspaceId))
        && get(memberDoc(workspaceId)).data.status == "active"
        && (
          get(memberDoc(workspaceId)).data.portfolioViewer == true
          || get(memberDoc(workspaceId)).data.role in ["owner", "admin"]
        );
    }

    function isWorkspaceAdmin(workspaceId) {
      return isSignedIn()
        && workspaceId != null
        && (
          get(/databases/$(database)/documents/workspaces/$(workspaceId)).data.ownerId == request.auth.uid ||
          (
            exists(memberDoc(workspaceId)) &&
            get(memberDoc(workspaceId)).data.status == "active" &&
            get(memberDoc(workspaceId)).data.role in ["owner", "admin"]
          )
        );
    }

    function isWorkspaceOwner(workspaceId) {
      return isSignedIn()
        && workspaceId != null
        && get(/databases/$(database)/documents/workspaces/$(workspaceId)).data.ownerId == request.auth.uid;
    }

    function hasExplicitUserAccess(data) {
      return (
        ('visibleToUserIds' in data) &&
        data.visibleToUserIds is list &&
        request.auth.uid in data.visibleToUserIds
      ) || (
        request.auth.token.email != null &&
        ('visibleToEmails' in data) &&
        data.visibleToEmails is list &&
        request.auth.token.email in data.visibleToEmails
      );
    }

    function hasProjectRoleAccess(data) {
      return ('workspaceId' in data) && data.workspaceId is string && (
        (('projectManagerId' in data) && data.projectManagerId == activeWorkspaceMemberId(data.workspaceId)) ||
        (('productOwnerId' in data) && data.productOwnerId == activeWorkspaceMemberId(data.workspaceId)) ||
        (('sponsorId' in data) && data.sponsorId == activeWorkspaceMemberId(data.workspaceId)) ||
        (('sponsorIds' in data) && data.sponsorIds is list && activeWorkspaceMemberId(data.workspaceId) in data.sponsorIds) ||
        (('teamMemberIds' in data) && data.teamMemberIds is list && activeWorkspaceMemberId(data.workspaceId) in data.teamMemberIds)
      );
    }

    function canReadProject(data) {
      return isSignedIn() && (
        data.userId == request.auth.uid ||
        (('createdBy' in data) && data.createdBy == request.auth.uid) ||
        (('ownerId' in data) && data.ownerId == request.auth.uid) ||
        hasExplicitUserAccess(data) ||
        hasProjectRoleAccess(data) ||
        (('workspaceId' in data) && isWorkspaceAdmin(data.workspaceId)) ||
        (('workspaceId' in data) && isWorkspaceMember(data.workspaceId) && isPortfolioViewer(data.workspaceId))
      );
    }

    function canWriteProject(data) {
      return isSignedIn() && (
        data.userId == request.auth.uid ||
        (('createdBy' in data) && data.createdBy == request.auth.uid) ||
        (('ownerId' in data) && data.ownerId == request.auth.uid) ||
        hasProjectRoleAccess(data) ||
        (('workspaceId' in data) && isWorkspaceAdmin(data.workspaceId))
      );
    }

    function canReadTask(data) {
      return isSignedIn() && (
        data.userId == request.auth.uid ||
        (('createdBy' in data) && data.createdBy == request.auth.uid) ||
        (('ownerId' in data) && data.ownerId == request.auth.uid) ||
        (('workspaceId' in data) && isWorkspaceOwner(data.workspaceId)) ||
        (('assigneeId' in data) && data.assigneeId == request.auth.uid) ||
        hasExplicitUserAccess(data) ||
        (
          ('workspaceId' in data) &&
          ('assigneeIds' in data) &&
          data.assigneeIds is list &&
          activeWorkspaceMemberId(data.workspaceId) in data.assigneeIds
        ) ||
        (
          ('workspaceId' in data) &&
          ('accessMemberIds' in data) &&
          data.accessMemberIds is list &&
          activeWorkspaceMemberId(data.workspaceId) in data.accessMemberIds
        ) || (
          ('sharedWithUserIds' in data) &&
          data.sharedWithUserIds is list &&
          request.auth.uid in data.sharedWithUserIds
        )
      );
    }

    function canWriteTask(data) {
      return canReadTask(data);
    }

    // Playbooks
    function isValidPlaybook(data) {
        return data.keys().hasAll(['userId', 'title', 'createdAt'])
        && data.userId is string && data.userId == request.auth.uid
        && data.title is string && data.title.size() <= 500
        && data.createdAt is timestamp
        && (!('workspaceId' in data) || data.workspaceId is string);
    }
    match /playbooks/{id} {
      allow get: if isSignedIn() && isValidId(id) && (resource == null || resource.data.userId == request.auth.uid);
      allow delete: if isSignedIn() && isValidId(id) && resource.data.userId == request.auth.uid;
      allow list: if isSignedIn() && resource.data.userId == request.auth.uid;
      allow create: if isSignedIn() && isValidId(id) && isValidPlaybook(incoming());
      allow update: if isSignedIn() && isValidId(id) && resource.data.userId == request.auth.uid && isValidPlaybook(incoming()) && incoming().userId == resource.data.userId && incoming().createdAt == resource.data.createdAt;
    }
    match /playbook_runs/{id} {
      allow read, write: if isSignedIn();
    }
    match /entity_links/{id} {
      allow read, write: if isSignedIn();
    }
    match /resources/{id} {
      allow read, write: if isSignedIn();
    }
    match /task_organize_runs/{id} {
      allow read, write: if isSignedIn();
    }
    match /task_organize_suggestions/{id} {
      allow read, write: if isSignedIn();
    }
    match /skills/{id} {
      allow create: if isSignedIn() && isValidId(id) && incoming().userId == request.auth.uid;
      allow get: if isSignedIn() && isValidId(id) && (resource == null || resource.data.userId == request.auth.uid);
      allow update, delete: if isSignedIn() && isValidId(id) && resource.data.userId == request.auth.uid;
      allow list: if isSignedIn() && resource.data.userId == request.auth.uid;
    }
    match /knowledge_items/{id} {
      allow create: if isSignedIn() && isValidId(id) && incoming().userId == request.auth.uid
        && (!('workspaceId' in incoming()) || isWorkspaceMember(incoming().workspaceId));
      allow get: if isSignedIn() && isValidId(id) && (resource == null || resource.data.userId == request.auth.uid || ('workspaceId' in resource.data && isWorkspaceMember(resource.data.workspaceId)));
      allow update, delete: if isSignedIn() && isValidId(id) && (resource.data.userId == request.auth.uid || ('workspaceId' in resource.data && isWorkspaceMember(resource.data.workspaceId)));
      allow list: if isSignedIn() && (resource.data.userId == request.auth.uid || ('workspaceId' in resource.data && isWorkspaceMember(resource.data.workspaceId)));
    }
    match /knowledge_folders/{id} {
      allow create: if isSignedIn() && isValidId(id) && incoming().userId == request.auth.uid;
      allow get: if isSignedIn() && isValidId(id) && (resource == null || resource.data.userId == request.auth.uid);
      allow update, delete: if isSignedIn() && isValidId(id) && resource.data.userId == request.auth.uid;
      allow list: if isSignedIn() && resource.data.userId == request.auth.uid;
    }
    match /knowledge_usage_logs/{id} {
      allow create: if isSignedIn() && isValidId(id) && incoming().userId == request.auth.uid;
      allow get: if isSignedIn() && isValidId(id) && (resource == null || resource.data.userId == request.auth.uid);
      allow update, delete: if isSignedIn() && isValidId(id) && resource.data.userId == request.auth.uid;
      allow list: if isSignedIn() && resource.data.userId == request.auth.uid;
    }
    match /skill_folders/{id} {
      allow create: if isSignedIn() && isValidId(id) && incoming().userId == request.auth.uid;
      allow get: if isSignedIn() && isValidId(id) && (resource == null || resource.data.userId == request.auth.uid);
      allow update, delete: if isSignedIn() && isValidId(id) && resource.data.userId == request.auth.uid;
      allow list: if isSignedIn() && resource.data.userId == request.auth.uid;
    }
    match /notion_connections/{id} {
      allow create: if isSignedIn() && isValidId(id) && incoming().userId == request.auth.uid;
      allow get: if isSignedIn() && isValidId(id) && (resource == null || resource.data.userId == request.auth.uid);
      allow update, delete: if isSignedIn() && isValidId(id) && resource.data.userId == request.auth.uid;
      allow list: if isSignedIn() && resource.data.userId == request.auth.uid;
    }
    match /system_context/{id} {
      allow create: if isSignedIn() && isValidId(id) && incoming().userId == request.auth.uid;
      allow get: if isSignedIn() && isValidId(id) && (resource == null || resource.data.userId == request.auth.uid);
      allow update, delete: if isSignedIn() && isValidId(id) && resource.data.userId == request.auth.uid;
      allow list: if isSignedIn() && resource.data.userId == request.auth.uid;
    }
    match /tool_permissions/{id} {
      allow create: if isSignedIn() && isValidId(id) && incoming().userId == request.auth.uid;
      allow get: if isSignedIn() && isValidId(id) && (resource == null || resource.data.userId == request.auth.uid);
      allow update, delete: if isSignedIn() && isValidId(id) && resource.data.userId == request.auth.uid;
      allow list: if isSignedIn() && resource.data.userId == request.auth.uid;
    }
    match /scheduled_tasks/{id} {
      allow create: if isSignedIn() && isValidId(id) && incoming().userId == request.auth.uid;
      allow get: if isSignedIn() && isValidId(id) && (resource == null || resource.data.userId == request.auth.uid);
      allow update, delete: if isSignedIn() && isValidId(id) && resource.data.userId == request.auth.uid;
      allow list: if isSignedIn() && resource.data.userId == request.auth.uid;
    }
    match /system_reviews/{id} {
      allow create: if isSignedIn() && isValidId(id) && incoming().userId == request.auth.uid;
      allow get: if isSignedIn() && isValidId(id) && (resource == null || resource.data.userId == request.auth.uid);
      allow update, delete: if isSignedIn() && isValidId(id) && resource.data.userId == request.auth.uid;
      allow list: if isSignedIn() && resource.data.userId == request.auth.uid;
    }
    match /agent_runs/{id} {
      allow create: if isSignedIn() && isValidId(id) && incoming().userId == request.auth.uid;
      allow get: if isSignedIn() && isValidId(id) && (resource == null || resource.data.userId == request.auth.uid);
      allow update, delete: if isSignedIn() && isValidId(id) && resource.data.userId == request.auth.uid;
      allow list: if isSignedIn() && resource.data.userId == request.auth.uid;
    }
    match /backup_runs/{id} {
      allow create: if isSignedIn() && isValidId(id) && incoming().userId == request.auth.uid;
      allow get: if isSignedIn() && isValidId(id) && (resource == null || resource.data.userId == request.auth.uid);
      allow update, delete: if isSignedIn() && isValidId(id) && resource.data.userId == request.auth.uid;
      allow list: if isSignedIn() && resource.data.userId == request.auth.uid;
    }

    // Users
    function isValidUser(data) {
      return data.keys().hasAll(['email', 'createdAt']) && data.keys().size() == 2
        && data.email is string && data.email.size() > 0 && data.email.size() <= 200
        && data.createdAt is timestamp;
    }
    match /users/{userId} {
      allow get: if isSignedIn() && isOwner(userId) && isValidId(userId);
      allow create: if isSignedIn() && isOwner(userId) && isValidId(userId)
                    && isValidUser(incoming());
      allow update: if isSignedIn() && isOwner(userId) && isValidId(userId)
                    && isValidUser(incoming())
                    && incoming().email == resource.data.email
                    && incoming().createdAt == resource.data.createdAt;
    }

    // Inbox Items
    function isValidInboxItem(data) {
      return data.keys().hasAll(['userId', 'content', 'typeHint', 'status', 'createdAt']) 
        && data.keys().hasOnly(['userId', 'content', 'typeHint', 'status', 'createdAt', 'workspaceId', 'createdBy', 'updatedAt', 'deletedAt', 'timeSector'])
        && data.userId is string && data.userId == request.auth.uid
        && data.content is string && data.content.size() <= 5000
        && data.typeHint is string && data.typeHint.size() <= 64
        && data.status is string && data.status.size() <= 64
        && data.createdAt is timestamp
        && (!('workspaceId' in data) || data.workspaceId is string)
        && (!('createdBy' in data) || data.createdBy is string)
        && (!('timeSector' in data) || data.timeSector is string)
        && (!('updatedAt' in data) || data.updatedAt is timestamp)
        && (!('deletedAt' in data) || data.deletedAt is timestamp);
    }
    match /inbox_items/{itemId} {
      allow get: if isSignedIn() && isValidId(itemId) && (resource == null || resource.data.userId == request.auth.uid);
      allow list: if isSignedIn() && resource.data.userId == request.auth.uid;
      allow create: if isSignedIn() && isValidId(itemId) && isValidInboxItem(incoming());
      allow update: if isSignedIn() && isValidId(itemId) && resource.data.userId == request.auth.uid
                    && isValidInboxItem(incoming())
                    && incoming().diff(resource.data).affectedKeys().hasOnly(['status', 'updatedAt', 'deletedAt'])
                    && incoming().userId == resource.data.userId
                    && incoming().createdAt == resource.data.createdAt;
      allow delete: if false; 
    }

    // Review Candidates
    function isValidReviewCandidate(data) {
       return data.keys().hasAll(['userId', 'title', 'type', 'why', 'source', 'proposed', 'confidence', 'action', 'status', 'createdAt']) 
        && data.keys().hasOnly(['userId', 'title', 'type', 'why', 'source', 'proposed', 'confidence', 'action', 'status', 'createdAt', 'actionCategory', 'priority', 'dueDate', 'projectId', 'owner', 'workspaceId', 'createdBy', 'sourceType', 'sourceId', 'agentRunId', 'updatedAt', 'approvedAt', 'approvedBy', 'convertedToType', 'convertedToId', 'originalReviewPayload', 'sourceReviewItemId', 'deletedAt', 'sourceItemId', 'linkedEntityType', 'linkedEntityId'])
        && data.userId is string && data.userId == request.auth.uid
        && data.title is string && data.title.size() <= 500
        && data.type is string && data.type.size() <= 50
        && data.why is string && data.why.size() <= 5000
        && data.source is string && data.source.size() <= 5000
        && data.proposed is map
        && data.confidence is string && data.confidence.size() <= 50
        && data.action is string && data.action.size() <= 500
        && data.status is string && data.status.size() <= 50
        && data.createdAt is timestamp
        && (!('actionCategory' in data) || data.actionCategory is string)
        && (!('priority' in data) || data.priority is string || data.priority is number)
        && (!('dueDate' in data) || data.dueDate is string)
        && (!('projectId' in data) || data.projectId is string)
        && (!('workspaceId' in data) || data.workspaceId is string)
        && (!('createdBy' in data) || data.createdBy is string)
        && (!('sourceType' in data) || data.sourceType is string)
        && (!('sourceId' in data) || data.sourceId is string)
        && (!('agentRunId' in data) || data.agentRunId is string)
        && (!('updatedAt' in data) || data.updatedAt is timestamp)
        && (!('approvedAt' in data) || data.approvedAt is timestamp)
        && (!('approvedBy' in data) || data.approvedBy is string)
        && (!('convertedToType' in data) || data.convertedToType is string)
        && (!('convertedToId' in data) || data.convertedToId is string)
        && (!('originalReviewPayload' in data) || data.originalReviewPayload is map)
        && (!('sourceReviewItemId' in data) || data.sourceReviewItemId is string)
        && (!('deletedAt' in data) || data.deletedAt is timestamp)
        && (!('owner' in data) || data.owner is string)
        && (!('sourceItemId' in data) || data.sourceItemId is string)
        && (!('linkedEntityType' in data) || data.linkedEntityType is string)
        && (!('linkedEntityId' in data) || data.linkedEntityId is string);
    }
    match /review_candidates/{candidateId} {
      allow get: if isSignedIn() && isValidId(candidateId) && (resource == null || resource.data.userId == request.auth.uid);
      allow list: if isSignedIn() && resource.data.userId == request.auth.uid;
      allow create: if isSignedIn() && isValidId(candidateId) && isValidReviewCandidate(incoming());
      allow update: if isSignedIn() && isValidId(candidateId) && resource.data.userId == request.auth.uid
                    && isValidReviewCandidate(incoming())
                    && incoming().diff(resource.data).affectedKeys().hasOnly(['status', 'actionCategory', 'priority', 'dueDate', 'owner', 'title', 'type', 'updatedAt', 'approvedAt', 'approvedBy', 'convertedToType', 'convertedToId', 'originalReviewPayload', 'sourceReviewItemId', 'deletedAt'])
                    && incoming().userId == resource.data.userId
                    && incoming().createdAt == resource.data.createdAt;
      allow delete: if isSignedIn() && isValidId(candidateId) && resource.data.userId == request.auth.uid;
    }

    // Workspace-shared cost models used by the delivery control tower.
    match /cost_templates/{id} {
      allow get, list: if isSignedIn() && isValidId(id)
        && (resource.data.userId == request.auth.uid || ('workspaceId' in resource.data && isWorkspaceMember(resource.data.workspaceId)));
      allow create: if isSignedIn() && isValidId(id)
        && incoming().userId == request.auth.uid
        && incoming().name is string && incoming().name.size() > 0 && incoming().name.size() <= 200
        && incoming().rows is list
        && incoming().createdAt is timestamp
        && incoming().workspaceId is string && isWorkspaceMember(incoming().workspaceId);
      allow update: if isSignedIn() && isValidId(id)
        && (resource.data.userId == request.auth.uid || ('workspaceId' in resource.data && isWorkspaceMember(resource.data.workspaceId)))
        && incoming().userId == resource.data.userId
        && incoming().workspaceId == resource.data.workspaceId
        && incoming().name is string && incoming().name.size() > 0 && incoming().name.size() <= 200
        && incoming().rows is list;
      allow delete: if isSignedIn() && isValidId(id)
        && (resource.data.userId == request.auth.uid || ('workspaceId' in resource.data && isWorkspaceMember(resource.data.workspaceId)));
    }

    // Projects
    function isValidProject(data) {
        return data.keys().hasAll(['userId', 'title', 'status', 'createdAt'])
        && data.userId is string
        && data.title is string && data.status is string
        && data.createdAt is timestamp;
    }
    match /projects/{id} {
      allow get: if isSignedIn() && isValidId(id) && (resource == null || canReadProject(resource.data));
      allow delete: if isSignedIn() && isValidId(id) && canWriteProject(resource.data);
      allow list: if isSignedIn() && canReadProject(resource.data);
      allow create: if isSignedIn() && isValidId(id) && isValidProject(incoming()) && incoming().userId == request.auth.uid && (!('workspaceId' in incoming()) || isWorkspaceMember(incoming().workspaceId));
      allow update: if isSignedIn() && isValidId(id) && canWriteProject(resource.data) && isValidProject(incoming()) 
                     && incoming().userId == resource.data.userId && incoming().createdAt == resource.data.createdAt;
    }

    // Milestones
    function isValidMilestone(data) {
        return data.keys().hasAll(['userId', 'title', 'projectId', 'status', 'createdAt'])
        && data.userId is string && data.userId == request.auth.uid
        && data.title is string && data.projectId is string && data.status is string
        && data.createdAt is timestamp;
    }
    match /milestones/{id} {
      allow get: if isSignedIn() && isValidId(id) && (resource == null || resource.data.userId == request.auth.uid || ('workspaceId' in resource.data && isWorkspaceMember(resource.data.workspaceId)));
      allow delete: if isSignedIn() && isValidId(id) && (resource.data.userId == request.auth.uid || ('workspaceId' in resource.data && isWorkspaceMember(resource.data.workspaceId)));
      allow list: if isSignedIn() && (resource.data.userId == request.auth.uid || request.auth.token.email != null);
      allow create: if isSignedIn() && isValidId(id) && isValidMilestone(incoming()) && (!('workspaceId' in incoming()) || isWorkspaceMember(incoming().workspaceId));
      allow update: if isSignedIn() && isValidId(id) && (resource.data.userId == request.auth.uid || ('workspaceId' in resource.data && isWorkspaceMember(resource.data.workspaceId))) && isValidMilestone(incoming()) 
                     && incoming().userId == resource.data.userId && incoming().createdAt == resource.data.createdAt;
    }

    // Generic Output items from Triage
    function isValidGenericItem(data) {
        return data.keys().hasAll(['userId', 'title', 'status', 'createdAt'])
        && data.userId is string && data.userId == request.auth.uid
        && data.title is string && data.status is string
        && data.createdAt is timestamp
        && (!('content' in data) || data.content is string)
        && (!('workspaceId' in data) || data.workspaceId is string)
        && (!('reviewItemId' in data) || data.reviewItemId is string)
        && (!('source' in data) || data.source is string)
        && (!('reason' in data) || data.reason is string)
        && (!('confidence' in data) || data.confidence is string || data.confidence is number)
        && (!('proposedPayload' in data) || data.proposedPayload is map || data.proposedPayload is string)
        && (!('sourceType' in data) || data.sourceType is string)
        && (!('sourceId' in data) || data.sourceId is string)
        && (!('createdBy' in data) || data.createdBy is string)
        && (!('type' in data) || data.type is string)
        && (!('itemType' in data) || data.itemType is string)
        && (!('updatedAt' in data) || data.updatedAt is timestamp);
    }

    // Decisions
    match /decisions/{id} {
      allow get: if isSignedIn() && isValidId(id) && (resource == null || resource.data.userId == request.auth.uid);
      allow delete: if isSignedIn() && isValidId(id) && resource.data.userId == request.auth.uid;
      allow list: if isSignedIn() && resource.data.userId == request.auth.uid;
      allow create: if isSignedIn() && isValidId(id) && isValidGenericItem(incoming());
      allow update: if isSignedIn() && isValidId(id) && resource.data.userId == request.auth.uid && isValidGenericItem(incoming()) && incoming().userId == resource.data.userId && incoming().createdAt == resource.data.createdAt;
    }

    // Waiting For
    match /waiting_for/{id} {
      allow get: if isSignedIn() && isValidId(id) && (resource == null || resource.data.userId == request.auth.uid);
      allow delete: if isSignedIn() && isValidId(id) && resource.data.userId == request.auth.uid;
      allow list: if isSignedIn() && resource.data.userId == request.auth.uid;
      allow create: if isSignedIn() && isValidId(id) && isValidGenericItem(incoming());
      allow update: if isSignedIn() && isValidId(id) && resource.data.userId == request.auth.uid && isValidGenericItem(incoming()) && incoming().userId == resource.data.userId && incoming().createdAt == resource.data.createdAt;
    }

    // Presentations
    match /presentations/{id} {
      allow get: if isSignedIn() && isValidId(id) && (resource == null || resource.data.userId == request.auth.uid);
      allow delete: if isSignedIn() && isValidId(id) && resource.data.userId == request.auth.uid;
      allow list: if isSignedIn() && resource.data.userId == request.auth.uid;
      allow create: if isSignedIn() && isValidId(id) && isValidGenericItem(incoming());
      allow update: if isSignedIn() && isValidId(id) && resource.data.userId == request.auth.uid && isValidGenericItem(incoming()) && incoming().userId == resource.data.userId && incoming().createdAt == resource.data.createdAt;
    }

