        && (!('workspaceId' in resource.data) || !('workspaceId' in data) || data.workspaceId == resource.data.workspaceId);
    }

    match /ai_initiatives/{id} {
      allow get, list: if canAccessUserOwnedRecord(resource.data);
      allow create: if isValidId(id) && canCreateUserOwnedRecord(incoming());
      allow update: if isValidId(id) && canAccessUserOwnedRecord(resource.data) && preservesUserOwnedRecord(incoming());
      allow delete: if isValidId(id) && canAccessUserOwnedRecord(resource.data);
    }

    match /prompt_assets/{id} {
      allow get, list: if canAccessUserOwnedRecord(resource.data);
      allow create: if isValidId(id) && canCreateUserOwnedRecord(incoming());
      allow update: if isValidId(id) && canAccessUserOwnedRecord(resource.data) && preservesUserOwnedRecord(incoming());
      allow delete: if isValidId(id) && canAccessUserOwnedRecord(resource.data);
    }

    match /prompt_versions/{id} {
      allow get, list: if canAccessUserOwnedRecord(resource.data);
      allow create: if isValidId(id) && canCreateUserOwnedRecord(incoming());
      allow update: if isValidId(id) && canAccessUserOwnedRecord(resource.data) && preservesUserOwnedRecord(incoming());
      allow delete: if isValidId(id) && canAccessUserOwnedRecord(resource.data);
    }

    match /ai_artifacts/{id} {
      allow get, list: if canAccessUserOwnedRecord(resource.data);
      allow create: if isValidId(id) && canCreateUserOwnedRecord(incoming());
      allow update: if isValidId(id) && canAccessUserOwnedRecord(resource.data) && preservesUserOwnedRecord(incoming());
      allow delete: if isValidId(id) && canAccessUserOwnedRecord(resource.data);
    }

    match /support_cases/{id} {
      allow get, list: if canAccessUserOwnedRecord(resource.data);
      allow create: if isValidId(id) && canCreateUserOwnedRecord(incoming());
      allow update: if isValidId(id) && canAccessUserOwnedRecord(resource.data) && preservesUserOwnedRecord(incoming());
      allow delete: if isValidId(id) && canAccessUserOwnedRecord(resource.data);
    }

    match /delivery_reviews/{id} {
      allow get, list: if canAccessUserOwnedRecord(resource.data);
      allow create: if isValidId(id) && canCreateUserOwnedRecord(incoming());
      allow update: if isValidId(id) && canAccessUserOwnedRecord(resource.data) && preservesUserOwnedRecord(incoming());
      allow delete: if isValidId(id) && canAccessUserOwnedRecord(resource.data);
    }

    match /delivery_gates/{id} {
      allow get, list: if canAccessUserOwnedRecord(resource.data);
      allow create: if isValidId(id) && canCreateUserOwnedRecord(incoming());
      allow update: if isValidId(id) && canAccessUserOwnedRecord(resource.data) && preservesUserOwnedRecord(incoming());
      allow delete: if isValidId(id) && canAccessUserOwnedRecord(resource.data);
    }

    match /integration_configs/{id} {
      allow get, list: if canAccessUserOwnedRecord(resource.data);
      allow create: if isValidId(id) && canCreateUserOwnedRecord(incoming());
      allow update: if isValidId(id) && canAccessUserOwnedRecord(resource.data) && preservesUserOwnedRecord(incoming());
      allow delete: if isValidId(id) && canAccessUserOwnedRecord(resource.data);
    }

    match /workspace_members/{memberId} {
      allow read: if isSignedIn() && (resource == null || resource.data.userId == request.auth.uid || exists(/databases/$(database)/documents/workspace_members/$(resource.data.workspaceId + "_" + request.auth.uid)));
      allow create, update: if isSignedIn() && (
        incoming().userId == request.auth.uid && (
          get(/databases/$(database)/documents/workspaces/$(incoming().workspaceId)).data.ownerId == request.auth.uid ||
          (request.auth.token.email != null && request.auth.token.email in get(/databases/$(database)/documents/workspaces/$(incoming().workspaceId)).data.members)
        ) ||
        get(/databases/$(database)/documents/workspaces/$(incoming().workspaceId)).data.ownerId == request.auth.uid
      );
      allow delete: if isSignedIn() && (
        resource.data.userId == request.auth.uid ||
        get(/databases/$(database)/documents/workspaces/$(resource.data.workspaceId)).data.ownerId == request.auth.uid
      );
    }

    match /war_room_chats/{id} { allow read, write: if isSignedIn(); }
    match /war_room_participants/{id} { allow read, write: if isSignedIn(); }
    match /war_room_messages/{id} { allow read, write: if isSignedIn(); }
    match /war_room_threads/{id} { allow read, write: if isSignedIn(); }
    match /boldi_agents/{id} { allow read, write: if isSignedIn(); }
    match /agent_templates/{id} { allow read, write: if isSignedIn(); }
    match /agent_runs/{id} { allow read, write: if isSignedIn(); }
    match /war_room_widgets/{id} { allow read, write: if isSignedIn(); }
    match /war_room_widget_versions/{id} { allow read, write: if isSignedIn(); }
    match /war_room_files/{id} { allow read, write: if isSignedIn(); }
    match /war_room_action_plans/{id} { allow read, write: if isSignedIn(); }
    match /war_room_audit_logs/{id} { allow read, write: if isSignedIn(); }
    match /agent_resources/{id} { allow read, write: if isSignedIn(); }
    match /agent_invites/{id} { allow read, write: if isSignedIn(); }
    match /sprints/{id} {
      allow read: if isSignedIn() && (resource == null || resource.data.userId == request.auth.uid || ('workspaceId' in resource.data && isWorkspaceMember(resource.data.workspaceId)));
      allow create: if isSignedIn() && incoming().userId == request.auth.uid && incoming().workspaceId is string && isWorkspaceMember(incoming().workspaceId);
      allow update, delete: if isSignedIn() && (resource.data.userId == request.auth.uid || ('workspaceId' in resource.data && isWorkspaceMember(resource.data.workspaceId)));
    }
    match /project_status_shares/{id} {
      allow get: if resource.data.revoked != true
        && resource.data.token == id
        && resource.data.snapshot is map;
      allow list: if isSignedIn() && (
        resource.data.userId == request.auth.uid ||
        ('workspaceId' in resource.data && isWorkspaceMember(resource.data.workspaceId))
      );
      allow create: if isSignedIn()
        && incoming().userId == request.auth.uid
        && incoming().token == id
        && incoming().snapshot is map
        && incoming().revoked == false;
      allow update: if isSignedIn() && resource.data.userId == request.auth.uid
        && incoming().diff(resource.data).affectedKeys().hasOnly(['revoked', 'updatedAt']);
      allow delete: if isSignedIn() && (
        resource.data.userId == request.auth.uid ||
        ('workspaceId' in resource.data && isWorkspaceAdmin(resource.data.workspaceId))
      );
    }
    match /contacts/{id} { allow read, write: if isSignedIn(); }
    match /contact_requests/{id} { allow read, write: if isSignedIn(); }
    match /agent_groups/{id} { allow read, write: if isSignedIn(); }
    match /agent_group_members/{id} { allow read, write: if isSignedIn(); }
    match /agent_workbench_templates/{id} { allow read, write: if isSignedIn(); }
    match /agent_moments/{id} { allow read, write: if isSignedIn(); }
    match /agent_widgets/{id} { allow read, write: if isSignedIn(); }
    match /agent_widget_versions/{id} { allow read, write: if isSignedIn(); }
    match /workspace_settings/{id} { allow read, write: if isSignedIn(); }
  }
}
