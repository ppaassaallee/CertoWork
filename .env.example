# Codex Sites production uses OpenAI. Store the real key in the Sites
# environment, never in this file or source control.
BOLDI_AI_PROVIDER=openai
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.6-luna
OPENAI_EFFICIENT_MODEL=gpt-5.6-luna
OPENAI_BALANCED_MODEL=gpt-5.6-luna
OPENAI_HEAVY_MODEL=gpt-5.6-luna
OPENAI_TRANSCRIPTION_MODEL=gpt-4o-mini-transcribe
OPENAI_MAX_OUTPUT_TOKENS=550
OPENAI_MAGIC_PROJECT_MAX_OUTPUT_TOKENS=900
ODYSSEUS_MAX_ROUNDS=1

# Existing Firebase auth/data compatibility for the local Express runtime.
FIREBASE_PROJECT_ID=your_firebase_project_id
FIREBASE_CLIENT_EMAIL=your_firebase_client_email
FIREBASE_PRIVATE_KEY=your_firebase_private_key
FIREBASE_DATABASE_ID=

# Optional legacy local adapter only. Codex Sites does not use Google AI Studio.
GEMINI_API_KEY=
CERTO_GEMINI_ENABLED=0
BOLDI_GEMINI_MODEL=gemini-2.5-flash-lite
BOLDI_GEMINI_FALLBACK_MODEL=gemini-2.5-flash-lite

# HTTP server
PORT=3000
NODE_ENV=development
CORS_ORIGIN=http://localhost:3000,https://certo.work,https://certo-work.gazellehunt.workers.dev

# HubSpot Integration
HUBSPOT_ACCESS_TOKEN=your_hubspot_access_token
HUBSPOT_TARGET_STAGE_ID=closed_won_handoff_required
HUBSPOT_WEBHOOK_SECRET=your_hubspot_webhook_secret

# Google Workspace / Drive Integration
GOOGLE_DRIVE_API_KEY=your_google_drive_api_key
GOOGLE_DRIVE_CLIENT_ID=your_google_client_id
GOOGLE_DRIVE_CLIENT_SECRET=your_google_client_secret

# Calendar connectors (Worker OAuth — Cloudflare Worker secrets; users connect via the in-app wizard)
GOOGLE_CALENDAR_CLIENT_ID=
GOOGLE_CALENDAR_CLIENT_SECRET=
CALENDAR_TOKEN_KEY=
CALENDAR_WEBHOOK_TOKEN=
# Outlook / Microsoft 365 (same wizard path; enable when connector ships)
MICROSOFT_CALENDAR_CLIENT_ID=
MICROSOFT_CALENDAR_CLIENT_SECRET=

# Retention (days) for conversations, audio captures, and audit logs
RETENTION_CONVERSATIONS_DAYS=365
RETENTION_AUDIO_DAYS=90
RETENTION_AUDIT_DAYS=730

# Optional backup destination for scheduled Firestore exports
FIRESTORE_BACKUP_BUCKET=

# Project / My Work overview (Flowly-style). Off in production until flipped.
# Dev defaults to on when unset; set 0 to disable locally.
VITE_OVERVIEW_ENABLED=0

# Agents aggregate network map (“Red de agentes”). Off by default.
# Per-routine Flujo lives under Rutinas. Set 1 only to show the network map
# under Agentes › Analítica.
VITE_AGENTS_MAP_ENABLED=0

# Item modal v2 (DunTasks hierarchy). On by default after ship.
# Set 0 only to force the legacy modal.
VITE_ITEM_MODAL_V2=1

# Views engine for project Items table (ViewGrid). Off by default —
# WorkItemsCenter stays identical until flipped to 1.
VITE_VIEWS_ENGINE=0

# Hermes Agent runtime (Prompt 2) — never expose these to the browser
# Preferred: Hermes Cloud + Nous Portal — see docs/agent-platform/16-hermes-cloud-setup.md
CERTO_HERMES_RUNTIME=0
# Cloud: https://your-instance-host  | Local: http://127.0.0.1:8642  (no trailing /v1)
HERMES_BASE_URL=http://127.0.0.1:8642
API_SERVER_KEY=
# Self-host gateway only (not used for Hermes Cloud path)
CERTO_RUNTIME_GATEWAY_URL=http://127.0.0.1:8787
CERTO_RUNTIME_GATEWAY_TOKEN=

# Chat Collab (mounted Chatwoot on certo.work, not a collab subdomain).
