{
  "name": "alejandro-os",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "tsx server.ts",
    "start": "node server.ts",
    "build": "tsc -b && rm -rf dist && vite build && mkdir -p dist/server dist/.openai && cp worker/*.js dist/server/ && cp .openai/hosting.json dist/.openai/hosting.json",
    "deploy:cloudflare": "npm run build && npx wrangler deploy",
    "deploy:cloudflare:dry": "npm run build && npx wrangler deploy --dry-run",
    "test": "tsx --test tests/*.test.ts",
    "lint": "eslint .",
    "preview": "vite preview"
  },
  "dependencies": {
    "@google/genai": "^2.0.1",
    "@hello-pangea/dnd": "^18.0.1",
    "@radix-ui/react-slot": "^1.1.0",
    "class-variance-authority": "^0.7.0",
    "clsx": "^2.1.1",
    "cors": "^2.8.6",
    "date-fns": "^4.1.0",
    "express": "^5.2.1",
    "express-rate-limit": "^8.6.2",
    "firebase": "^12.13.0",
    "firebase-admin": "^14.0.0",
    "helmet": "^8.3.0",
    "lucide-react": "^0.453.0",
    "motion": "^12.38.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.27.0",
    "recharts": "^3.8.1",
    "sql.js": "^1.14.1",
    "tailwind-merge": "^2.5.4",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@eslint/js": "9.39.5",
